<?xml version="1.0" encoding="utf-8"?>
<!--
  Shizuku 경로 PoC(DESIGN §5.15·§5.16, 2026-10-03). 제품 코드 아님. 통신사 권한 방식(poc/carrier)과 별개.
  목적(현재): 통신사 권한이 없어도 사용자가 설치·동의한 Shizuku를 통해 앱이 전화 설정(허용 망 사유별 값)을
        '읽고', POWER 사유로 5G(NR)만 '잠깐 막았다 되돌리는' 제어가 레퍼런스 폰(막힌 폰 대역)에서 되는지 확인한다.
        호출은 ShizukuBinderWrapper로 Shizuku(shell 신분)를 거친다(원격 binder 호출). USER 사유는 절대 안 씀.
        되돌리기는 내구적 기록 + 소유권 비교(우리가 쓴 값일 때만 복원, best-effort)로 사용자 변경을 덮지 않으려 한다
        (원자적 CAS는 플랫폼 미지원 — TOCTOU/ABA 한계, 제품 §5.6.3과 동일).
        관측(PCC 콜백)은 이 PoC 범위 아님 — §5.15 방향 A(bindUserService 호스팅)에서 별도.
  관측(PCC 콜백)은 이 PoC 범위 아님 — §5.15 방향 A(bindUserService 호스팅)에서 별도.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="nrc.shizupoc"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

    <!-- Shizuku 사용 승인을 요청하기 위한 권한(공식 provider aar가 요구) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 재부팅 뒤 '되돌릴 기록'이 남았을 때 사용자에게 알리기 위한 권한(특권 아님, self-bootstrap 아님) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- no-wifi 관측 하네스(BootProbe)용: 부팅 뒤 통로 복구를 수 분 관측하는 포그라운드 서비스 + 네트워크·Wi-Fi 스위치 상태 읽기.
         모두 특권 아님. 관측 전용이라 전화 설정은 쓰지 않는다. (DESIGN §5.18 '새 후보 탐색 2차') -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 시작하기 화면(ProbeControl)이 Shizuku 이름표 앱이 깔렸는지·Shizuku-Next 서명인지 읽고 그 앱을 열 수 있게(안드로이드 11+ 앱 보기 제한) -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application android:label="NR Shizuku PoC" android:hasCode="true"
        android:debuggable="true"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning,HardcodedDebugMode">
        <activity android:name=".Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- no-wifi 관측 하네스 켜기/끄기·로그 보기 화면(ProbeControl). Main과 분리(관측 쪽은 전화 설정 쓰기 코드와 안 섞음). -->
        <activity android:name=".ProbeControl" android:exported="true" android:label="NR no-wifi probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 재부팅 뒤 '되돌릴 기록'이 남아 있으면 알림으로 알린다(BootReceiver, 특권 없음) -->
        <receiver android:name=".BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- no-wifi 관측 하네스(포그라운드 서비스). 관측 전용: pingBinder/상태 읽기만, 전화 설정 안 씀(구조적 fail-open). -->
        <service android:name=".BootProbe" android:exported="false" android:foregroundServiceType="dataSync" />

        <!-- 공식 Shizuku provider: 앱이 Shizuku binder를 받는 통로 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="nrc.shizupoc.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
    </application>
</manifest>
